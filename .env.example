# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL CONFIGURATION (Nodemailer)
# The SMTP service or provider (e.g., gmail, outlook, custom)
SMTP_SERVICE="gmail"
# The host address of your SMTP server (e.g., smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"
# The port of your SMTP server (e.g., 587 or 465)
SMTP_PORT="587"
# The email address used to log in and send emails (SMTP username)
EMAIL_USER="your-email@gmail.com"
# The app-specific password or API key for your email account
EMAIL_PASS="your-app-password"
# The personal email address where you want to receive the contact form emails
EMAIL_RECEIVER="jophtgrph@gmail.com"

